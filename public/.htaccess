# LESEKESE SPA — cPanel / Apache hardening + fallback
# Routes every request that isn't a real file/folder to index.html
# so browser-router paths (e.g. /products) survive hard refreshes.
# Upload the contents of /dist (including this file) into public_html.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Exclude real files (assets, images, favicons)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html (SPA fallback)
  RewriteRule ^ index.html [L]
</IfModule>

# ================= Security Headers (OWASP A05/A02 hardening) =================
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Block clickjacking
  Header set X-Frame-Options "SAMEORIGIN"

  # Control referrer leakage
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable sites being embedded anywhere / restrict browser features
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Legacy XSS auditor (defense in depth; modern CSP is the primary control)
  Header set X-XSS-Protection "1; mode=block"

  # Framing + navigation guard
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Resource-Policy "same-site"

  # HSTS (only effective over HTTPS; cPanel auto-SSL should be enabled)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Content-Security-Policy:
  #  - self for scripts/styles (bundled assets)
  #  - inline styles allowed from motion/framer (it injects style props)
  #  - fonts + styles from Google Fonts CDN
  #  - images from self, data:, i.ibb.co, and other CDNs used on the site
  #  - connect to Formspree/Privyr endpoints for the inquiry form
  #  - wa.me / tel: links are navigations, not fetches
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ibb.co https://lesekeseproducts.com; connect-src 'self' https://formspree.io https://api.formspree.io https://*.privyr.com https://privyr.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formspree.io https://api.formspree.io; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# Served files: gzip compression if available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache static hashed assets aggressively (safe: filenames are content-hashed by Vite)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>